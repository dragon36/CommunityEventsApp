# =============================================================================
# COMMUNITY EVENTS APP - FIREBASE FUNCTIONS ENVIRONMENT
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# FIREBASE ADMIN (Server-side only)
# Get these from Firebase Console > Project Settings > Service Accounts
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (for welcome emails, notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_DOMAIN=communityevents.app
APP_NAME=Community Events
APP_URL=https://communityevents.app
SUPPORT_EMAIL=support@communityevents.app

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR SYNC
# Get these from Google Cloud Console > APIs & Services > Credentials
# Enable Google Calendar API
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-project.cloudfunctions.net/oauth2callback

# -----------------------------------------------------------------------------
# STRIPE (if enabling payments/tickets)
# Get these from Stripe Dashboard > Developers > API Keys
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# -----------------------------------------------------------------------------
# SENTRY (Error tracking for functions)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# -----------------------------------------------------------------------------
# OPTIONAL: EXTERNAL APIs
# -----------------------------------------------------------------------------
# MAPBOX_API_KEY=your-mapbox-api-key
# OPENAI_API_KEY=your-openai-api-key (for AI recommendations)