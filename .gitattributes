# Ensure consistent line endings and handle binary files

# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.md text
*.txt text
*.yml text
*.yaml text
*.toml text
*.ini text
*.config text
*.sh text
*.bash text
*.zsh text
*.fish text
*.ps1 text
*.bat text
*.cmd text

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp4 binary
*.mov binary
*.avi binary
*.mkv binary
*.mp3 binary
*.wav binary
*.ogg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary
*.apk binary
*.ipa binary
*.aab binary
*.dmg binary
*.exe binary
*.msi binary
*.app binary
*.framework binary

# Handle lock files
package-lock.json text
yarn.lock text
pnpm-lock.yaml text

# Handle config files
.eslintrc.js text
.prettierrc text
.prettierrc.js text
.prettierrc.json text
.stylelintrc text
.stylelintrc.js text
.stylelintrc.json text
.editorconfig text
.gitignore text
.gitattributes text
.gitmodules text