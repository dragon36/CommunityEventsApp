# =============================================================================
# COMMUNITY EVENTS APP - DEVELOPMENT ENVIRONMENT
# =============================================================================
# This file is for local development only
# Copy to .env and fill in your values
# NEVER commit this file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# EXPO / EAS CONFIGURATION
# -----------------------------------------------------------------------------
EXPO_PROJECT_ID=your-expo-project-id
EXPO_OWNER=your-expo-username
NODE_ENV=development
APP_VARIANT=development
EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_EMULATOR_HOST=localhost

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Client-side)
# Get these from Firebase Console > Project Settings > General > Your apps
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# GOOGLE MAPS API KEYS
# Get these from Google Cloud Console > APIs & Services > Credentials
# Restrict keys to your bundle ID / package name
# -----------------------------------------------------------------------------
EXPO_IOS_GOOGLE_MAPS_API_KEY=your-ios-google-maps-api-key
EXPO_ANDROID_GOOGLE_MAPS_API_KEY=your-android-google-maps-api-key

# -----------------------------------------------------------------------------
# GOOGLE PLACES API KEYS (for autocomplete)
# Get these from Google Cloud Console > APIs & Services > Credentials
# Enable Places API for your project
# -----------------------------------------------------------------------------
EXPO_IOS_GOOGLE_PLACES_API_KEY=your-ios-google-places-api-key
EXPO_ANDROID_GOOGLE_PLACES_API_KEY=your-android-google-places-api-key

# -----------------------------------------------------------------------------
# APPLE / iOS SPECIFIC
# -----------------------------------------------------------------------------
APPLE_TEAM_ID=your-apple-team-id
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APNS_AUTH_KEY\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# SENTRY (Error tracking)
# Get these from Sentry.io > Settings > Projects > Your Project > Client Keys (DSN)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# -----------------------------------------------------------------------------
# OPTIONAL: ANALYTICS / THIRD PARTY SERVICES
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# EXPO_PUBLIC_SEGMENT_WRITE_KEY=your-segment-write-key
# EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key