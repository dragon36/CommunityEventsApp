# ============================================
# Community Events App - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ----------------------------------------------------------------------
# Firebase Configuration (get from Firebase Console > Project Settings)
# ----------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------------------------------
# Google Maps & Places API (get from Google Cloud Console)
# Enable: Maps SDK for iOS, Maps SDK for Android, Places API, Geocoding API
# ----------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key
EXPO_IOS_GOOGLE_MAPS_API_KEY=your-ios-maps-api-key
EXPO_ANDROID_GOOGLE_MAPS_API_KEY=your-android-maps-api-key
EXPO_IOS_GOOGLE_PLACES_API_KEY=your-ios-places-api-key
EXPO_ANDROID_GOOGLE_PLACES_API_KEY=your-android-places-api-key

# ----------------------------------------------------------------------
# App Configuration
# ----------------------------------------------------------------------
EXPO_PUBLIC_APP_NAME=CommunityEvents
EXPO_PUBLIC_APP_SCHEME=communityevents

# ----------------------------------------------------------------------
# Expo / EAS Configuration (get from expo.dev)
# ----------------------------------------------------------------------
EXPO_PROJECT_ID=your-expo-project-id
EXPO_OWNER=your-expo-username

# ----------------------------------------------------------------------
# Firebase Admin (for Cloud Functions - server-side only)
# ----------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------------------------
# Apple Developer (for iOS builds)
# ----------------------------------------------------------------------
APPLE_TEAM_ID=your-apple-team-id
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APNS_AUTH_KEY\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------------------------
# Admin Emails (comma-separated list of admin user emails)
# ----------------------------------------------------------------------
EXPO_PUBLIC_ADMIN_EMAILS=admin@example.com,admin2@example.com

# ----------------------------------------------------------------------
# Optional: Sentry for Error Tracking
# ----------------------------------------------------------------------
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# ----------------------------------------------------------------------
# Optional: Analytics
# ----------------------------------------------------------------------
EXPO_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX